    "eslint-plugin-prettier": "^5.5.6",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
